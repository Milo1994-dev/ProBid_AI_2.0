# ============================================================================
# ProBid AI 2.0 — Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ============================================================================

# DATABASE CONFIGURATION
DATABASE_URL=postgresql://user:password@localhost:5432/probid_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT=30000

# REDIS CONFIGURATION (Optional but recommended for production)
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# SECURITY & SESSION MANAGEMENT
SESSION_SECRET=your-random-session-secret-here-min-32-chars
CSRF_SECRET=your-random-csrf-secret-here-min-32-chars
HEAD_SECRET=your-random-head-secret-here-min-32-chars

# EXTERNAL API KEYS
OPENAI_API_KEY=sk-proj-...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
PROCORE_CLIENT_ID=...
PROCORE_CLIENT_SECRET=...
GOOGLE_PLACES_API_KEY=...

# MONITORING & ERROR TRACKING
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# APPLICATION URLS
APP_URL=https://probidcore.net
CLIENT_URL=https://probidcore.net
API_BASE_URL=https://probidcore.net/api

# GOOGLE ANALYTICS & MARKETING
GOOGLE_ANALYTICS_ID=G-...
GOOGLE_ADS_CONVERSION_ID=...
META_PIXEL_ID=...

# FILE STORAGE
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# FEATURE FLAGS & CONFIGURATION
SMOKE_MODE=0
NODE_ENV=development
PORT=5000

# SDK & PARTNER CONFIGURATION
SDK_ALLOWED_ORIGINS=https://partner1.com,https://partner2.com

# REPLIT DEPLOYMENT (Optional)
REPLIT_DEPLOYMENT=1
REPLIT_DEV_DOMAIN=pro-bid-core.replit.dev

# DEVELOPER OPTIONS
DEBUG=probid:*
LOG_LEVEL=info
VERBOSE_LOGGING=0
