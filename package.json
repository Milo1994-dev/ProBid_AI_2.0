{
  "name": "probid-core",
  "version": "1.0.0",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "build": "tsc",
    "build:client": "cd client && npm run build",
    "build:all": "npm run build:client && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "bash scripts/smoke.sh",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "openai": "^6.16.0",
    "p-limit": "^7.2.0",
    "p-retry": "^7.1.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "resend": "^6.12.2",
    "sharp": "^0.34.5",
    "stripe": "^16.12.0",
    "vitest": "^4.1.4",
    "zod": "^4.3.5",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "tar": "^7.5.11",
    "svix": "^1.92.2",
    "uuid": "^14.0.0",
    "postcss": "^8.5.10",
    "esbuild@<=0.24.2": "^0.25.10",
    "ip-address": "^10.2.0"
  }
}
